generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  cedula    String   @unique // Identificador principal
  fullName  String
  email     String?  // Ej: usuario@informaticosvenezuela.com
  gerencia  String?
  unidad    String?
  role      String   @default("Solicitante") // Solicitante, TÃ©cnico IT, Super Admin
  status             String   @default("Activo") // Activo, Inactivo
  password           String   @default("sat2026")
  mustChangePassword Boolean  @default(false)
  fcmToken           String?  // Token para notificaciones push (Firebase)
  createdAt          DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets        Ticket[] @relation("UserTickets")
  handledTickets Ticket[] @relation("TechTickets")
  messages       TicketMessage[]
}

model Category {
  id                  String   @id @default(uuid())
  title               String   @unique
  requiresDescription Boolean  @default(false)
  requiresImage       Boolean  @default(false)
  tickets             Ticket[]
}

model Ticket {
  id           String   @id @default(uuid())
  correlative  Int      @default(0)
  title        String
  priority     String   @default("Media") // Baja, Media, Alta, Urgente
  status       String   @default("En Espera") // En Espera, En Proceso, Cerrado (Conforme), etc.
  description  String
  imageUrl     String?
  remoteId     String?  // Código AnyDesk o RustDesk
  
  // Informe de solución y evidencia del técnico
  resolutionNotes    String?
  resolutionImageUrl String?
  closedAt           DateTime?

  // Calificación del solicitante
  rating             Int?     // 1 a 5 estrellas
  ratingFeedback     String?  // Comentario del solicitante

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  userId      String?
  user        User?     @relation("UserTickets", fields: [userId], references: [id], onDelete: SetNull)
  
  techId      String?
  tech        User?    @relation("TechTickets", fields: [techId], references: [id], onDelete: SetNull)
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  messages    TicketMessage[]
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message    String
  isInternal Boolean  @default(false) // true = solo visible para técnicos y super admin
  createdAt  DateTime @default(now())
}

model BotRule {
  id        String   @id @default(uuid())
  keywords  String
  response  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
