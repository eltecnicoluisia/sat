generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  cedula    String   @unique // Identificador principal
  fullName  String
  email     String?  // Ej: usuario@inapymi.gob.ve
  gerencia  String?
  unidad    String?
  role      String   @default("Solicitante") // Solicitante, TÃ©cnico IT, Super Admin
  status             String   @default("Activo") // Activo, Inactivo
  password           String   @default("inapymi")
  mustChangePassword Boolean  @default(false)
  fcmToken           String?  // Token para notificaciones push (Firebase)
  createdAt          DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets        Ticket[] @relation("UserTickets")
  handledTickets Ticket[] @relation("TechTickets")
}

model Category {
  id                  String   @id @default(uuid())
  title               String   @unique
  requiresDescription Boolean  @default(false)
  requiresImage       Boolean  @default(false)
  tickets             Ticket[]
}

model Ticket {
  id           String   @id @default(uuid())
  correlative  Int      @default(0)
  title        String
  status       String   @default("En Espera") // En Espera, En Proceso, Cerrado
  description  String
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  userId      String?
  user        User?     @relation("UserTickets", fields: [userId], references: [id], onDelete: SetNull)
  
  techId      String?
  tech        User?    @relation("TechTickets", fields: [techId], references: [id], onDelete: SetNull)
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
}

model BotRule {
  id        String   @id @default(uuid())
  keywords  String
  response  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
